<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_surface_background"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include android:id="@+id/card_quick_wifi" layout="@layout/card_quick_tile"/>
            <include android:id="@+id/card_quick_bluetooth" layout="@layout/card_quick_tile"/>
            <include android:id="@+id/card_quick_data" layout="@layout/card_quick_tile"/>
            <include android:id="@+id/card_quick_hotspot" layout="@layout/card_quick_tile"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="12dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="@color/homepage_style_circle_purple"/>
            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/card_dot"/>
            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/card_dot"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
